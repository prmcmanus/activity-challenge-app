# Copy to .env (not tracked in git) and fill in real values before deploying.
# The .env file lives on the server only and a deploy must never overwrite it.

# Host port the container's port 3000 is published on.
HTTP_PORT=3000

# Public URL this deployment is reachable at. Used to build shareable invite links
# (e.g. https://activetogether.team/?code=XXXXXXXX) — set it to the real public domain
# even before that domain is wired up, so links already look right once it is.
APP_ORIGIN=http://localhost:3000

# Seeded fallback admin account, created only if it doesn't already exist.
# Change the password before exposing this deployment to anyone.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# reCAPTCHA v2 ("I'm not a robot") on the registration and sign-in pages. Optional: leave both
# blank to disable it entirely (registration/login just work with no captcha step) — useful for
# local dev, and what the automated tests assume. Get a key pair at
# https://www.google.com/recaptcha/admin for your real domain (localhost works automatically for
# testing even if it isn't on the registered domain list).
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=

# The shared Apple Shortcut for iPhone sync: its iCloud link (Share -> Copy iCloud Link in the Shortcuts
# app), e.g. https://www.icloud.com/shortcuts/0123abcd... Optional; the website offers it once set.
# SHORTCUT_URL=

# Bot/abuse precautions. Defaults are sensible for a small self-hosted deployment; override only
# if you're seeing false positives (e.g. a whole office behind one NAT'd IP) or want it stricter.
# AUTH_RATE_LIMIT_MAX=20          # register+login attempts allowed per IP per window (each has its own bucket)
# AUTH_RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
# API_RATE_LIMIT_MAX=300          # general ceiling across all /api/ routes, per IP per window
# API_RATE_LIMIT_WINDOW_MS=60000    # 1 minute
# UPLOAD_RATE_LIMIT_MAX=30        # image uploads (avatars/logos/description images) per IP per window
# UPLOAD_RATE_LIMIT_WINDOW_MS=900000 # 15 minutes

# --- Standby machine and failover (optional; see "Standby machine and failover" in README.md) ---
# Only needed on the two machines of a primary/standby pair; a plain `docker compose up` ignores them.
# HOST_ID=server1                     # unique per machine, e.g. its hostname
# PEER_SSH=paul@192.168.0.11          # how this machine SSHes to the other one, to stop it on takeover
# PEER_DIR=Docker/activity-challenge  # deployment directory on the other machine
# R2_BUCKET=activetogether-standby
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# TUNNEL_TOKEN=                       # token of the Cloudflare tunnel dedicated to this app
